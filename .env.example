# ==========================================
# DinoFlow Environment Configuration
# ==========================================

# Server & Network
PORT=3001
NODE_ENV=development
API_HOST=0.0.0.0

# Database (TimescaleDB / PostgreSQL / Tiger Cloud)
# Local docker format: postgresql://postgres:postgrespassword@localhost:5432/dinoflow
# Tiger Cloud format: postgresql://user:password@region.tsdb.cloud.timescale.com:port/tsdb?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/dinoflow

# MQTT Message Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=dinoflow-backend

# AI Integration - Google Gemini (Enrichment only; system works 100% offline without it)
GEMINI_API_KEY=

# Voice & Sound - ElevenLabs (Fallback to Web Speech API offline)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Financial Estimates
WATER_COST_PER_M3=25.50
DEFAULT_CURRENCY=MXN

# Web Client URLs
VITE_API_URL=http://localhost:3001
VITE_MQTT_WS_URL=ws://localhost:9001
