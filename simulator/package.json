{
  "name": "dinoflow-simulator",
  "version": "1.0.0",
  "description": "DinoFlow IoT Sensor Simulator with realistic water hydraulics and anomaly injection",
  "main": "simulator.js",
  "scripts": {
    "start": "node simulator.js",
    "fuga-lenta": "node simulator.js --scenario fuga_lenta",
    "fuga-grande": "node simulator.js --scenario fuga_grande",
    "falta-agua": "node simulator.js --scenario falta_agua",
    "baja-presion": "node simulator.js --scenario baja_presion",
    "congelamiento": "node simulator.js --scenario congelamiento",
    "nocturno": "node simulator.js --scenario consumo_anomalo_nocturno",
    "normal": "node simulator.js --scenario normal"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mqtt": "^5.10.4"
  }
}
